PROJECT_NAME=RetailFlow
APP_ENV=development
API_V1_STR=/api/v1
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

MONGODB_URI=mongodb://mongodb:27017
MONGO_DB_NAME=retailflow
